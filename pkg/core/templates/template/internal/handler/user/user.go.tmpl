package user

import (
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"github.com/DVV-15324/witches/pkg/core/response_logger/logger"

	"context"
	entityUser "{{.ModuleName}}//internal/entity/user"
)

type IUserUseCase interface {
	//UsecaseCreateUser(ctx context.Context, user *entityUser.User) (int, *c_response.Response)
	GetAllUser(ctx context.Context) ([]*entityUser.User, *u_response.ErrorResponse)
	GetUserById(ctx context.Context, id int) (*entityUser.User, *u_response.ErrorResponse)
}
type UserHandle struct {
	Log         *logger.EntityLogger
	UserUseCase IUserUseCase
}

func NewUserHandle(userUseCase IUserUseCase, log *logger.EntityLogger) *UserHandle {
	return &UserHandle{
		Log:         log,
		UserUseCase: userUseCase,
	}
}
