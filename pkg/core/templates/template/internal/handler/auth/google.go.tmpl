package auth

import (
	dtoAuth "example_2/internal/dto/auth/request"
	helper "example_2/internal/utils"
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
	"github.com/gin-gonic/gin"
	"net/http"
)

func (h *AuthHandle) HandleGoogleLogin() func(c *gin.Context) {
	return func(c *gin.Context) {
		var req dtoAuth.GoogleLoginRequest

		if err := c.ShouldBindJSON(&req); err != nil {
			c.JSON(http.StatusBadRequest, gin.H{"error": "Invalid request"})
			return
		}

		// Use helper to get device info
		deviceID, ipAddress, userAgent, locale, timeZone := helper.GetDeviceInfo(c)

		token, err := h.UsecaseAuth.LoginWithGoogle(
			c.Request.Context(),
			req.AccessToken,
			deviceID,
			ipAddress,
			userAgent,
			locale,
			timeZone,
		)

		if err != nil {
			w_resp.WriteError(c, h.Log, err)
			return
		}
		w_resp.WriteSuccess(c, token)
	}
}
