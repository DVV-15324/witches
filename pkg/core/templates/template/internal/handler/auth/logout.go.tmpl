package auth

import (
	"errors"
	helper "{{.ModuleName}}/internal/utils"
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"github.com/gin-gonic/gin"
	"strings"
	"time"
)

type LogoutRequest struct {
	RefreshToken string `json:"refresh_token" binding:"required"`
}

func (h *AuthHandle) HandleLogout() func(c *gin.Context) {
	return func(c *gin.Context) {
		var req LogoutRequest

		if err := c.ShouldBindJSON(&req); err != nil {
			u_response.WriteError(c, h.Log, u_response.NewErrorResponse(400, errors.New("invalid request body"), time.Now()))
			return
		}

		// Get access token from Authorization header
		authHeader := c.GetHeader("Authorization")
		var accessToken string
		if len(authHeader) > 7 && strings.ToLower(authHeader[:7]) == "bearer " {
			accessToken = authHeader[7:]
		}

		if accessToken == "" {
			u_response.WriteError(c, h.Log, u_response.NewErrorResponse(401, errors.New("access token is required"), time.Now()))
			return
		}

		// Use helper to get device info

		deviceID, _, _, _ := helper.GetDeviceInfo(c)

		if err := h.UsecaseAuth.Logout(c.Request.Context(), accessToken, req.RefreshToken, deviceID); err != nil {
			u_response.WriteError(c, h.Log, err)
			return
		}

		u_response.WriteSuccess(c, gin.H{"message": "logout success"})
	}
}
