package auth

import (
	dtoAuth "{{.ModuleName}}/internal/dto/auth/request"
	mapping "{{.ModuleName}}/internal/mapping"
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"time"

	"github.com/gin-gonic/gin"
)

func (h *AuthHandle) HandleRegister() func(c *gin.Context) {
	return func(c *gin.Context) {
		var data dtoAuth.Register

		// Bind JSON first
		err := c.ShouldBindJSON(&data)
		if err != nil {
			resq := u_response.NewErrorResponse(400, err, time.Now())
			u_response.WriteError(c, h.Log, resq)
			return
		}

		// Then validate
		err_valid := data.Validate()
		if err_valid != nil {
			resq := u_response.NewErrorResponse(401, err_valid, time.Now())
			u_response.WriteError(c, h.Log, resq)
			return // Added missing return
		}

		// Fixed: Use the data variable, not an empty struct
		entity := mapping.FromRegisterToEntityAuth(&data)
		nameUser := data.Name

		// Register
		resq := h.UsecaseAuth.Register(c.Request.Context(), entity, nameUser)
		if resq != nil {
			u_response.WriteError(c, h.Log, resq)
			return
		}
		u_response.WriteSuccess(c, "Dang ki thanh cong")
	}
}
