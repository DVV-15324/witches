package auth

import (
	dtoAuth "{{.ModuleName}}/internal/dto/auth/request"
	mapping "{{.ModuleName}}/internal/mapping"
	helper "{{.ModuleName}}/internal/utils"
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"github.com/gin-gonic/gin"
	"time"
)

func (h *AuthHandle) HandleLogin() func(c *gin.Context) {
	return func(c *gin.Context) {
		var data dtoAuth.Login

		// Bind JSON first
		err := c.ShouldBindJSON(&data)
		if err != nil {
			resq := u_response.NewErrorResponse(400, err, time.Now())
			u_response.WriteError(c, h.Log, resq)
			return
		}

		// Then validate
		err_valid := data.Validate()
		if err_valid != nil {
			resq := u_response.NewErrorResponse(401, err_valid, time.Now())
			u_response.WriteError(c, h.Log, resq)
			return
		}

		entity := mapping.FromLoginToEntityAuth(&data)

		// Use helper to get device info
		deviceID, deviceName, ipAddress, userAgent := helper.GetDeviceInfo(c)

		claims, resq := h.UsecaseAuth.Login(c.Request.Context(), entity, deviceID, deviceName, ipAddress, userAgent)
		if resq != nil {
			u_response.WriteError(c, h.Log, resq)
			return
		}
		u_response.WriteSuccess(c, claims)
	}
}
