package refresh

import (
	"context"
	"encoding/json"
	"errors"
	"time"

	entityRefresh "{{.ModuleName}}/internal/entity/refresh"

	"gorm.io/gorm"
)

func (r *RefreshTokenRepository) GetByToken(ctx context.Context, token string) (*entityRefresh.RefreshToken, error) {
	// 1. Check cache
	cached, err := r.getCachedToken(ctx, token)
	if err == nil && cached != nil {
		return cached, nil
	}

	// 2. Query DB
	var rt entityRefresh.RefreshToken
	err = r.db.WithContext(ctx).Where("token = ?", token).First(&rt).Error
	if err != nil {
		if errors.Is(err, gorm.ErrRecordNotFound) {
			// Cache "not found" để tránh cache penetration
			r.cacheNotFound(ctx, token)
			return nil, nil
		}
		return nil, err
	}

	// 3. Cache kết quả
	if !rt.Revoked && time.Now().Before(time.Unix(rt.ExpiresAt, 0)) {
		r.cacheToken(ctx, &rt)
	}
	return &rt, nil
}
func (r *RefreshTokenRepository) GetActiveByUserID(ctx context.Context, userID uint32) ([]*entityRefresh.RefreshToken, error) {
	// 1. Check cache
	cacheKey := r.cacheKeyActiveTokens(userID)
	cached, err := r.redis.Get(ctx, cacheKey).Result()
	if err == nil {
		var tokens []*entityRefresh.RefreshToken
		if err := json.Unmarshal([]byte(cached), &tokens); err == nil {
			return tokens, nil
		}
	}

	// 2. Query DB
	var tokens []*entityRefresh.RefreshToken
	err = r.db.WithContext(ctx).
		Where("user_id = ? AND revoked = ? AND expires_at > ?", userID, false, time.Now()).
		Order("created_at DESC").
		Find(&tokens).Error
	if err != nil {
		return nil, err
	}

	// 3. Cache kết quả
	if len(tokens) > 0 {
		data, _ := json.Marshal(tokens)
		r.redis.Set(ctx, cacheKey, data, 5*time.Minute)
	}

	return tokens, nil
}
