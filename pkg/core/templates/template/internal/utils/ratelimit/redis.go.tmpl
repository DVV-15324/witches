package ratelimit

import (
	"context"
	"errors"
	"time"

	"github.com/redis/go-redis/v9"
)

// RedisRateLimiter dùng Redis INCR + EXPIRE
type RedisRateLimiter struct {
	client *redis.Client
	limit  int
	ttl    time.Duration
}

func NewRedisRateLimiter(client *redis.Client, limit int, ttl time.Duration) *RedisRateLimiter {
	return &RedisRateLimiter{
		client: client,
		limit:  limit,
		ttl:    ttl,
	}
}

func (r *RedisRateLimiter) Allow(key string) (bool, error) {
	ctx := context.Background()
	redisKey := "rate_limit:" + key

	pipe := r.client.Pipeline()
	incr := pipe.Incr(ctx, redisKey)
	pipe.Expire(ctx, redisKey, r.ttl)
	_, err := pipe.Exec(ctx)
	if err != nil && !errors.Is(err, redis.Nil) {
		return false, err
	}

	count, err := incr.Result()
	if err != nil {
		return false, err
	}

	return count <= int64(r.limit), nil
}

func (r *RedisRateLimiter) Reset(key string) error {
	ctx := context.Background()
	return r.client.Del(ctx, "rate_limit:"+key).Err()
}
