package refresh

import (
	"context"
	"{{.ModuleName}}/cmd/server/config"
	entityAuth "{{.ModuleName}}/internal/entity/auth"
	entityRefresh "{{.ModuleName}}/internal/entity/refresh"
	entityUser "{{.ModuleName}}/internal/entity/user"
	"{{.ModuleName}}/internal/utils"
	u_jwt "{{.ModuleName}}/internal/utils"

	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
)

type IRefreshTokenRepository interface {
	Create(ctx context.Context, token *entityRefresh.RefreshToken) error
	GetByToken(ctx context.Context, token string) (*entityRefresh.RefreshToken, error)
	GetActiveByUserID(ctx context.Context, userID uint32) ([]*entityRefresh.RefreshToken, error)
	Revoke(ctx context.Context, token string, reason string) error
	RevokeAllByUser(ctx context.Context, userID uint32, reason string) error
	DeleteExpired(ctx context.Context) error
}
type IJwt interface {
	ParseToken(ctx context.Context, tokenStr string) (*u_jwt.JwtClaims, error)
	IssueAccessToken(ctx context.Context, sub string, tid string, role u_jwt.Role) (*u_jwt.Token, error)
	IssueRefreshToken(ctx context.Context, sub string, tid string, role u_jwt.Role) (*u_jwt.Token, error)
	IssueTokenPair(ctx context.Context, sub string, tid string, role u_jwt.Role) (*u_jwt.TokenResponse, error)
}

type IAuthUsecase interface {
	GetAuthByUserId(ctx context.Context, userId int) (*entityAuth.Auth, *u_response.ErrorResponse)
	GetAuthByEmail(ctx context.Context, email string) (*entityAuth.Auth, *u_response.ErrorResponse)
}

type IUserUseCase interface {
	CreateUser(ctx context.Context, user *entityUser.User) (int, *u_response.ErrorResponse)
	GetUserById(ctx context.Context, id int) (*entityUser.User, *u_response.ErrorResponse)
}

type RefreshUseCase struct {
	Jwt              IJwt
	AuthUsecase      IAuthUsecase
	RefreshTokenRepo IRefreshTokenRepository
	UserUseCase      IUserUseCase
	SessionService   *utils.SessionService
	BlacklistService *utils.BlacklistService
	Config           *config.Config
}

func NewRefreshUseCase(userUseCase IUserUseCase, refreshTokenRepo IRefreshTokenRepository, jwt IJwt, sessionService *utils.SessionService,
	blacklistService *utils.BlacklistService, config *config.Config) *RefreshUseCase {
	return &RefreshUseCase{
		UserUseCase:      userUseCase,
		Jwt:              jwt,
		RefreshTokenRepo: refreshTokenRepo,
		SessionService:   sessionService,
		BlacklistService: blacklistService,
		Config:           config,
	}
}

func (r *RefreshUseCase) SetAuthUseCase(authUsecase IAuthUsecase) *RefreshUseCase {
	return &RefreshUseCase{
		AuthUsecase: authUsecase,
	}
}
