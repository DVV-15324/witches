package user

import (
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
	"time"

	"context"
	entityUser "{{.ModuleName}}/internal/entity/user"
)

func (u *UserUseCase) GetAllUser(ctx context.Context) ([]*entityUser.User, *w_resp.AppError) {
	users, err := u.UserResponsitory.GetAllUser(ctx)
	if err != nil {
		resp := w_resp.NewAppError(500, err, time.Now())
		return nil, resp
	}
	return users, nil
}

func (u *UserUseCase) GetUserById(ctx context.Context, id int) (*entityUser.User, *w_resp.AppError) {
	user, err := u.UserResponsitory.GetUserById(ctx, id)
	if err != nil {
		resp := w_resp.NewAppError(404, err, time.Now())
		return nil, resp
	}
	return user, nil
}
