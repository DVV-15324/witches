package usecase

import (
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
	"time"

	"context"
	modelUser "{{.ModuleName}}/internal/shared/model"
)

func (u *UserUseCase) CreateUser(ctx context.Context, user *modelUser.User) (int, *w_resp.AppError) {
	uid, err := u.UserResponsitory.CreateUser(ctx, user)
	if err != nil {
		resp := w_resp.NewAppError(500, err, time.Now())
		return 0, resp
	}
	return uid, nil
}
