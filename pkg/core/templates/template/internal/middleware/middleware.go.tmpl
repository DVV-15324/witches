package middleware

import (
	"context"
	"errors"
	w_resp "github.com/DVV-15324/witches/pkg/core/response_logger"
	"github.com/DVV-15324/witches/pkg/core/response_logger/logger"
	w_utils "github.com/DVV-15324/witches/pkg/core/utils"
	"github.com/gin-gonic/gin"
	"time"
	utils "{{.ModuleName}}/internal/utils"
)

type UsecaseAuth interface {
	IntrospectToken(ctx context.Context, accessToken string) (*w_utils.JwtClaims, *w_resp.ErrorResponse)
}

func AuthMiddleware(
	usecaseAuth UsecaseAuth,
	sessionSvc *w_utils.SessionService,
	blacklistSvc *w_utils.BlacklistService,
	log *logger.EntityLogger,
) gin.HandlerFunc {
	return func(c *gin.Context) {
		// Lấy tid từ RequestContext
		tid := u_ctx.GetTid(c.Request.Context(), utils.ReqKey)
		if tid == "" {
			// Fallback: lấy từ Gin context
			if val, exists := c.Get("tid"); exists {
				tid = val.(string)
			}
		}
		// 1.
		// En: Extract token
		// Vi: Trích xuất mã Token
		token, err := utils.ExtractTokenFromHeader(c.GetHeader("Authorization"))
		if err != nil {
			resp := w_resp.NewErrorResponse(401, err, time.Now())
			w_resp.WriteError(c, log, resp)
			c.Abort()
			return
		}
		// 1.1
		// En: Get device Info
		// Vi: Lấy device Info
		deviceID, ipAddress, userAgent, locale, timeZone := utils.GetDeviceInfo(c)
		// 2.
		// En: Check blacklist
		// Vi: Kiểm tra blacklist
		isBlacklisted := blacklistSvc.IsTokenBlacklisted(c.Request.Context(), token)
		if isBlacklisted {
			resp := w_resp.NewErrorResponse(401, errors.New("Error: token has been revoked"), time.Now())
			w_resp.WriteError(c, log, resp)
			c.Abort()
			return
		}

		//3.
		// En:  Verify Access Token
		// Vi: Xác thực access token
		claims, errResp := usecaseAuth.IntrospectToken(c.Request.Context(), token)
		if errResp != nil {
			w_resp.WriteError(c, log, errResp)
			c.Abort()
			return
		}

		// 4.
		// En: Get userID from claims
		// Vi: Lấy userID từ claims
		UID := u_uid.DecodeFromBase58(claims.Subject)
		userID := UID.LocalID

		if userID == 0 {
			resp := w_resp.NewErrorResponse(401, errors.New("Error: invalid user ID in token"), time.Now())
			w_resp.WriteError(c, log, resp)
			c.Abort()
			return
		}

		// 5.
		// En: Get request context
		// Vi: Lấy request context
		reqCtx := u_ctx.GetRequestContext(c.Request.Context(), utils.ReqKey)

		session, err := sessionSvc.ValidateSession(c.Request.Context(), userID, deviceID, token)
		if err != nil {
			// Session không hợp lệ → blacklist token để tránh dùng lại
			blacklistSvc.BlacklistToken(c.Request.Context(), token)
			resp := w_resp.NewErrorResponse(401, err, time.Now())
			w_resp.WriteError(c, log, resp)
			c.Abort()
			return
		}

		// 6: Save Context
		reqCtx.Sub = claims.Subject
		reqCtx.SessionID = session.SessionID
		reqCtx.DeviceID = deviceID
		reqCtx.IPAddress = ipAddress
		reqCtx.UserAgent = userAgent
		reqCtx.Locale = locale
		reqCtx.Timezone = timeZone
		ctx := u_ctx.SaveRequestContext(c.Request.Context(), reqCtx, utils.ReqKey)
		c.Request = c.Request.WithContext(ctx)

		//6.1: RBAC kiểm tra role của token
		//

		// 7: Next()
		c.Next()

		// 8.
		// Chạy async để không block response
		go func() {
			ctxBg, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			sessionSvc.UpdateLastActive(ctxBg, userID, deviceID)
		}()
	}
}
