package middleware

import (
	"context"
	"crypto/md5"
	"errors"
	"fmt"
	"strings"
	"time"

	"{{.ModuleName}}/internal/utils"
	u_jwt "{{.ModuleName}}/internal/utils"
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"github.com/DVV-15324/witches/pkg/core/response_logger/logger"
	u_uid "github.com/DVV-15324/witches/pkg/core/utils"
	"github.com/gin-gonic/gin"
)

type UsecaseAuth interface {
	IntrospectToken(ctx context.Context, accessToken string) (*u_jwt.JwtClaims, *u_response.ErrorResponse)
}

func AuthMiddleware(
	usecaseAuth UsecaseAuth,
	sessionSvc *utils.SessionService,
	blacklistSvc *utils.BlacklistService,
	log *logger.EntityLogger,
) gin.HandlerFunc {
	return func(c *gin.Context) {
		// 1.
		// En: Extract token
		// Vi: Trích xuất mã Token
		token, err := extractTokenFromHeader(c.GetHeader("Authorization"))
		if err != nil {
			resp := u_response.NewErrorResponse(401, err, time.Now())
			u_response.WriteError(c, log, resp)
			c.Abort()
			return
		}

		// 2.
		// En: Check blacklist
		// Vi: Kiểm tra blacklist
		isBlacklisted := blacklistSvc.IsTokenBlacklisted(c.Request.Context(), token)
		if isBlacklisted {
			resp := u_response.NewErrorResponse(401, errors.New("Error: token has been revoked"), time.Now())
			u_response.WriteError(c, log, resp)
			c.Abort()
			return
		}

		//3.
		// En:  Verify Access Token
		// Vi: Xác thực access token
		claims, errResp := usecaseAuth.IntrospectToken(c.Request.Context(), token)
		if errResp != nil {
			u_response.WriteError(c, log, errResp)
			c.Abort()
			return
		}

		// 4.
		// En: Get userID from claims
		// Vi: Lấy userID từ claims
		UID := u_uid.DecodeFromBase58(claims.Subject)
		userID := UID.LocalID

		if userID == 0 {
			resp := u_response.NewErrorResponse(401, errors.New("Error: invalid user ID in token"), time.Now())
			u_response.WriteError(c, log, resp)
			c.Abort()
			return
		}

		// 5.
		// En: Get request context
		// Vi: Lấy request context
		reqCtx := utils.GetRequestContext(c.Request.Context())

		deviceID := reqCtx.DeviceID
		session, err := sessionSvc.ValidateSession(c.Request.Context(), userID, deviceID, token)
		if err != nil {
			// Session không hợp lệ → blacklist token để tránh dùng lại
			blacklistSvc.BlacklistToken(c.Request.Context(), token)
			resp := u_response.NewErrorResponse(401, err, time.Now())
			u_response.WriteError(c, log, resp)
			c.Abort()
			return
		}

		// 6: Save Context
		reqCtx.Sub = claims.Subject
		reqCtx.SessionID = session.SessionID
		reqCtx.DeviceID = deviceID
		reqCtx.IPAddress = c.ClientIP()
		reqCtx.UserAgent = c.GetHeader("User-Agent")

		ctx := utils.SaveRequestContext(c.Request.Context(), reqCtx)
		c.Request = c.Request.WithContext(ctx)

		// Lưu vào gin context
		c.Set("user_id", userID)
		c.Set("device_id", deviceID)
		c.Set("session", session)
		c.Set("claims", claims)
		c.Set("access_token", token)
		c.Set("session_id", reqCtx.SessionID)
		c.Set("request_context", reqCtx)

		// 7: Next()
		c.Next()

		// 8.
		// Chạy async để không block response
		go func() {
			ctxBg, cancel := context.WithTimeout(context.Background(), 5*time.Second)
			defer cancel()
			sessionSvc.UpdateLastActive(ctxBg, userID, deviceID)
		}()
	}
}

// extractTokenFromHeader - Trích xuất token từ header Authorization
func extractTokenFromHeader(authHeader string) (string, error) {
	if authHeader == "" {
		return "", errors.New("authorization header is required")
	}

	parts := strings.Split(authHeader, " ")
	if len(parts) != 2 || strings.ToLower(parts[0]) != "bearer" {
		return "", errors.New("invalid authorization header format, expected 'Bearer <token>'")
	}

	token := strings.TrimSpace(parts[1])
	if token == "" {
		return "", errors.New("token is empty")
	}

	return token, nil
}

// generateDeviceID - Tạo deviceID từ IP + User-Agent
func generateDeviceID(ip, userAgent string) string {
	data := fmt.Sprintf("%s|%s", ip, userAgent)
	return fmt.Sprintf("%x", md5.Sum([]byte(data)))
}
