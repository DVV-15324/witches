package repository

import (
	"context"
	mapping "{{.ModuleName}}/internal/refresh/mapping"
	domainRefresh "{{.ModuleName}}/internal/shared/domain"
)

func (r *RefreshTokenRepository) Create(ctx context.Context, token *domainRefresh.RefreshToken) error {
	modelToken := mapping.FromDomainToModelRefresh(token)
	if err := r.db.WithContext(ctx).Create(modelToken).Error; err != nil {
		return err
	}
	return r.cacheToken(ctx, modelToken)
}
