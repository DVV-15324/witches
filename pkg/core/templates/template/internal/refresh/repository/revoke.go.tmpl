package repository

import (
	"context"

	"time"

	modelRefresh "{{.ModuleName}}/internal/refresh/model"
)

func (r *RefreshTokenRepository) Revoke(ctx context.Context, token string, reason string) error {
	now := time.Now()
	err := r.db.WithContext(ctx).
		Model(&modelRefresh.RefreshToken{}).
		Where("token = ?", token).
		Updates(map[string]interface{}{
			"revoked":        true,
			"revoked_at":     now,
			"revoked_reason": reason,
		}).Error
	if err != nil {
		return err
	}

	// Invalidate cache
	r.deleteCacheToken(ctx, token)
	r.invalidateUserCache(ctx, token)
	return nil
}

func (r *RefreshTokenRepository) RevokeAllByUser(ctx context.Context, userID uint32, reason string) error {
	now := time.Now()
	err := r.db.WithContext(ctx).
		Model(&modelRefresh.RefreshToken{}).
		Where("user_id = ? AND revoked = ?", userID, false).
		Updates(map[string]interface{}{
			"revoked":        true,
			"revoked_at":     now,
			"revoked_reason": reason,
		}).Error
	if err != nil {
		return err
	}

	// Invalidate cache
	r.redis.Del(ctx, r.cacheKeyActiveTokens(userID))
	return nil
}
