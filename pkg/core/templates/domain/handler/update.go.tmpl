package handler

import (
	"strconv"
	"time"
	"{{.ModuleName}}/internal/{{.FolderName}}/dto/request"
	"github.com/gin-gonic/gin"
	domain{{.NameCap}} "{{.ModuleName}}/internal/shared/domain"
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
)

func (h *{{.NameCap}}Handler) Update(c *gin.Context) {
	id, err := strconv.Atoi(c.Param("id"))
	if err != nil {
		resp := w_resp.NewAppError(400, err, time.Now())
		w_resp.WriteErrorWithLog(c, h.Log, h.Cfg, resp)
		return
	}

	var req request.Update{{.NameCap}}Request
	if err := c.ShouldBindJSON(&req); err != nil {
		resp := w_resp.NewAppError(400, err, time.Now())
		w_resp.WriteErrorWithLog(c, h.Log, h.Cfg, resp)
		return
	}


	domain := domain{{.NameCap}}.{{.NameCap}}{}
	resp := h.usecase.Update(c.Request.Context(), id, &domain)

	if resp != nil {
		w_resp.WriteErrorWithLog(c, h.Log, h.Cfg, resp)
		return
	}
	w_resp.WriteSuccess(c, "cap nhat thanh cong")
}