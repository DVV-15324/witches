// DTO ↔ Domain

func FromDtoToDomain{{.NameCap}}(dto *dto{{.NameCap}}.{{.NameCap}}) *domain{{.NameCap}}.{{.NameCap}} {
	if dto == nil {
		return nil
	}
	return &domain{{.NameCap}}.{{.NameCap}}{
		ID:        int(utils.DecodeFromBase58(dto.ID).LocalID),
		CreatedAt: dto.CreatedAt,
		UpdatedAt: dto.UpdatedAt,
	}
}

// List DTO → List domain (dùng generic)
func FromDtoToDomain{{.NameCap}}List(dtos []*dto{{.NameCap}}.{{.NameCap}}) []*domain{{.NameCap}}.{{.NameCap}} {
	return w_utils.MapPtrSlice(dtos, FromDtoToDomain{{.NameCap}})
}

