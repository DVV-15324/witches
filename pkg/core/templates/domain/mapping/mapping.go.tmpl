package mapping

import (
	domain{{.NameCap}} "{{.ModuleName}}/internal/shared/domain"
	"{{.ModuleName}}/internal/shared/utils"
	dto{{.NameCap}} "{{.ModuleName}}/internal/{{.Name}}/dto/response"
	model{{.NameCap}} "{{.ModuleName}}/internal/{{.Name}}/model"
