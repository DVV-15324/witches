package handler

import (
	"time"
	mapping "{{.ProjectName}}/internal/{{.Name}}/mapping"
	"strconv"
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
	"github.com/gin-gonic/gin"
	w_utils "github.com/DVV-15324/witches/pkg/core/utils"
)

func (h *{{.NameCap}}Handler) GetByID() func(*gin.Context) {
	return func(ctx *gin.Context) {
	id, err := strconv.Atoi(ctx.Param("id"))
	if err != nil {
		resp := w_resp.NewAppError(400, err, time.Now())
		w_resp.WriteErrorWithLog(ctx, h.core.Logger, h.core.Config, resp)
		return
	}

	data, err_get := h.usecase.GetByID(ctx.Request.Context(), id)
	if err_get != nil {
		w_resp.WriteErrorWithLog(ctx, h.core.Logger, h.core.Config, err_get)
		return
	}
	dto := mapping.FromDomainToDto{{.NameCap}}(data)
	w_resp.WriteSuccess(ctx, dto)
}
}


func (h *{{.NameCap}}Handler) GetAll() func(*gin.Context) {
	return func(ctx *gin.Context) {
	req := w_utils.PaginationRequest{}
	data, total, err := h.usecase.GetAll(ctx.Request.Context(), &req)
	if err != nil {
		w_resp.WriteErrorWithLog(ctx, h.core.Logger, h.core.Config, err)
		return
	}
	dto := mapping.FromDomainToDto{{.NameCap}}List(data)
	paginationResp := req.ToPaginationResponse(total)
	w_resp.WriteSuccessWithPagination(ctx, dto, &paginationResp)
}
}