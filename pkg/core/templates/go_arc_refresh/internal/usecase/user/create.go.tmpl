package user

import (
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
	"time"

	"context"
	entityUser "{{.ModuleName}}//internal/entity/user"
)

func (u *UserUseCase) CreateUser(ctx context.Context, user *entityUser.User) (int, *u_response.ErrorResponse) {
	uid, err := u.UserResponsitory.CreateUser(ctx, user)
	if err != nil {
		resp := u_response.NewErrorResponse(500, err, time.Now())
		return 0, resp
	}
	return uid, nil
}
