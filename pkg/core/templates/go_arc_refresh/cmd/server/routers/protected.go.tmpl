package routes

import (
	middleware "example/internal/middleware"
	h_s "github.com/DVV-15324/witches/pkg/core/handle_swagger"
	u_response "github.com/DVV-15324/witches/pkg/core/response_logger"
)

// En: This function groups the routes that need to be authenticated together.
//
// Vi: Hàm nhóm các routes cần xác thực với nhau.
func setupProtectedRoutes(gen *h_s.SwaggerGenerator, services *HandleServices) {
	// En: Auth middleware
	// Vi: Middleware
	authMW := middleware.AuthMiddleware(
		services.UsecaseRefresh,
		services.Session,
		services.Blacklist,
		services.Logger,
	)

	// En: Logout
	// Vi: Đăng xuất
	gen.POST("/v1/auth/logout").
		Summary("User logout").
		Description("Logout user and invalidate JWT token").
		Tags("auth").
		Security("BearerAuth").
		Response(200, u_response.ResponseHandle{}, "Logout successful").
		Response(401, u_response.ResponseHandle{}, "Unauthorized").
		Use(authMW).
		Handler(services.HandleAuth.HandleLogout()).
		Build()

	// En: Get user by ID
	// Vi: Lấy người dùng theo ID
	gen.POST("/v1/user/get_user").
		Summary("Get user by ID").
		Description("Get user details by user ID").
		Tags("user").
		Security("BearerAuth").
		Body(map[string]int{"id": 0}, "User ID").
		Response(200, u_response.ResponseHandle{}, "User found").
		Response(404, u_response.ResponseHandle{}, "User not found").
		Use(authMW).
		Handler(services.HandleUser.HandleGetUserById()).
		Build()

	// En: Get all users
	// Vi: Lấy tất cả người dùng
	gen.POST("/v1/user/get_user_all").
		Summary("Get all users").
		Description("Get list of all users").
		Tags("user").
		Security("BearerAuth").
		Response(200, u_response.ResponseHandle{}, "Users list").
		Use(authMW).
		Handler(services.HandleUser.HandleGetAllUser()).
		Build()
}
