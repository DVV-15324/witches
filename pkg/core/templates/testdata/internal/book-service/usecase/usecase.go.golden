package usecase

import (
	"context"
	w_utils "github.com/DVV-15324/witches/pkg/core/utils"
	modelBook "github.com/example/test/internal/shared/model"
)


type IBookRepository interface {
	Create(ctx context.Context, e *modelBook.Book) ( error)
	GetByID(ctx context.Context, id int) (*modelBook.Book, error)
	GetAll(ctx context.Context, req *w_utils.PaginationRequest) ([]*modelBook.Book, int64, error)
	Update(ctx context.Context, e *modelBook.Book, id int) error
	Delete(ctx context.Context, id int) error
}


type BookUsecase struct {
	repo IBookRepository
}

func NewBookUsecase(repo IBookRepository) *BookUsecase {
	return &BookUsecase{repo: repo}
}
