package handler

import (
	"context"
	"github.com/DVV-15324/witches/pkg/core/response/logger"
	w_resp "github.com/DVV-15324/witches/pkg/core/response"
	modelBook "github.com/example/test/internal/shared/model"

)
type IBookUsecase interface {
	Create(ctx context.Context, req *modelBook.Book) (*w_resp.AppError)
	GetByID(ctx context.Context, id int) (*modelBook.Book, *w_resp.AppError)
	GetAll(ctx context.Context) ([]*modelBook.Book, int64, *w_resp.AppError)
	Update(ctx context.Context, id int, req *modelBook.Book) (*w_resp.AppError)
	Delete(ctx context.Context, id int) *w_resp.AppError
}
type BookHandler struct {
	Log         *logger.EntityLogger
	usecase IBookUsecase
}

// NewBookHandler - Constructor
func NewBookHandler(usecase IBookUsecase, log *logger.EntityLogger) *BookHandler {
	return &BookHandler{
	usecase: usecase,
	Log:         log,
	}
}